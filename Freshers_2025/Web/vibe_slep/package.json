    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "dotenv": "^16.3.1",
    "cookie-parser": "^1.4.6",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
